use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */

/**
 * @var int $productId
 * @see \Magento\ProductAlert\Controller\Unsubscribe\Email::execute
 */
$productId = $block->getProductId();

/**
 * This template turns a GET request into a POST request by auto-submitting the form below
 */
?>

<form
    action="<?= $escaper->escapeUrl($block->getUrl('productalert/unsubscribe/stock')) ?>"
    method="post"
    x-data="initProductAlertEmail"
>
    <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
    <input type="hidden" id="productId" name="product" value="<?= $escaper->escapeHtml($productId) ?>">
</form>

<script>
    window.addEventListener('alpine:init', () => {
        Alpine.data('initProductAlertEmail', () => ({
            init() {
                this.$root.submit();
            }
        }))
    }, { once: true })
</script>
<?php $hyvaCsp->registerInlineScript() ?>
